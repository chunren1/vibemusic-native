<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Auth token store must never be backed up (API < 31 path; see data_extraction_rules.xml). -->
    <exclude domain="file" path="datastore/auth.preferences_pb" />
    <!-- 离线音频（可达数百 MB）与热点素材不进云备份/换机迁移：
         超出 25MB 配额会让整包备份失败，且用户音频不应离开设备。
         注：流媒体缓存在 cacheDir（系统本就不备份），无需排除。 -->
    <exclude domain="file" path="offline" />
    <exclude domain="file" path="hotspot" />
</full-backup-content>
