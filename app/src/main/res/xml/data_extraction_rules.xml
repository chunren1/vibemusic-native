<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Auth token store must never leave the device. -->
        <exclude domain="file" path="datastore/auth.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/auth.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
